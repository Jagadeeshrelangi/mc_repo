# Copy to `.env` and fill in values. Never commit the real `.env`.
# Values shown are defaults used by backend/app/core/config.py.

PROJECT_NAME=Mecha Connect Backend
LOG_LEVEL=INFO

# Optional: only used when a valid key is set. Real Gemini keys start "AIzaSy".
GEMINI_API_KEY=

# Optional: path to a Firebase service-account JSON (unused in the current scaffold).
FIREBASE_CREDENTIALS_PATH=

# true (default) -> use local rule-based fallback when no valid Gemini key.
# false -> Gemini-dependent endpoints return HTTP 422 without a valid key.
ENABLE_FALLBACK=true

# Comma-separated CORS allow-list (used with allow_credentials=True).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
