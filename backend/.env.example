# Copy to `.env` and fill in values. Never commit the real `.env`.
# Values shown are defaults used by backend/app/core/config.py.

PROJECT_NAME=Mecha Connect Backend
LOG_LEVEL=INFO

# Optional: only used when a valid key is set. Real Gemini keys start "AIzaSy".
GEMINI_API_KEY=

# Optional: path to a Firebase service-account JSON (unused in the current scaffold).
FIREBASE_CREDENTIALS_PATH=

# true (default) -> use local rule-based fallback when no valid Gemini key.
# false -> Gemini-dependent endpoints return HTTP 422 without a valid key.
ENABLE_FALLBACK=true

# Comma-separated CORS allow-list (used with allow_credentials=True).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL async connection string (Sprint 2 database foundation).
# SQLAlchemy + asyncpg. Leave EMPTY until a database is provisioned — the app
# boots and serves AI/health endpoints without it.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# Example (never commit real credentials):
# DATABASE_URL=postgresql+asyncpg://mecha:CHANGE_ME@localhost:5432/mecha_connect
DATABASE_URL=

# JWT authentication (Sprint 2, Task 3). Generating a strong secret:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# REQUIRED once auth endpoints go live. No fallback secret is baked into the
# app — auth simply remains unavailable until this is set.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
